# =====================================================
# SignSpeak AI Service — Example Environment Variables
# =====================================================
#
# Copy this file to .env and fill in your actual values.
# Never commit the real .env to version control.

# ── Service ───────────────────────────────────────
SERVICE_NAME=signspeak-ai
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────
CORS_ORIGINS=*

# ── Model Files ───────────────────────────────────
# Relative to ai_service root or absolute
MODEL_PATH=models/signspeak_combined_best.keras
MEAN_PATH=models/feature_mean.npy
STD_PATH=models/feature_std.npy
CLASS_PATH=models/class_names.json
HAND_MODEL_PATH=assets/hand_landmarker.task

# ── Recognition settings ──────────────────────────
SEQUENCE_LENGTH=32
FEATURES_PER_FRAME=126
NUM_HANDS=2
INFERENCE_WIDTH=384

# ── Thresholds ────────────────────────────────────
CONFIDENCE_THRESHOLD=60
MIN_HAND_DETECTION_CONFIDENCE=0.20
MIN_HAND_PRESENCE_CONFIDENCE=0.20
MIN_TRACKING_CONFIDENCE=0.20

# ── Performance ───────────────────────────────────
PREDICTION_INTERVAL=0.08
MAX_FRAME_SIZE_BYTES=5242880

# ── Sentence builder ──────────────────────────────
DUPLICATE_COOLDOWN=2.0

# ── Node.js Backend ───────────────────────────────
NODE_BACKEND_URL=http://127.0.0.1:5000
